# ── Environment ────────────────────────────────────────────────
ENV=dev

# ── Ollama (local LLM) ─────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_WEAK_MODEL=qwen2.5:3b-instruct

# ── PostgreSQL + pgvector (data store) ─────────────────────────
DATABASE_URL=postgresql+psycopg2://guardrails:guardrails_dev@localhost:5432/guardrails_db
POSTGRES_USER=guardrails
POSTGRES_PASSWORD=guardrails_dev
POSTGRES_DB=guardrails_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Langfuse (self-hosted observability) ───────────────────────
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Vector store (optional, demo retrieval) ────────────────────
FAISS_INDEX_PATH=./data/faiss_index

# ── Evaluation ──────────────────────────────────────────────────
DEEPEVAL_JUDGE_MODEL=llama3.1
